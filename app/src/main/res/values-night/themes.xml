<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Night theme -->
    <style name="Theme.SmartDocAI" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary & Secondary -->


        <!-- Background & Surfaces (night values come from colors-night.xml) -->
        <item name="colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>

        <item name="colorOnSurface">@color/colorOnSurface</item>

        <!-- Error -->
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>

        <!-- BottomSheet aware overlay -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SmartDocAI.BottomSheet</item>

        <!-- System bars -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:navigationBarColor" tools:targetApi="o_mr1">?attr/colorSurface</item>


        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md3_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md3_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_onSecondary</item>
        <item name="colorTertiary">@color/md3_tertiary</item>
        <item name="colorOnTertiary">@color/md3_onTertiary</item>

        <item name="android:colorBackground">@color/md3_background</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surfaceVariant</item>
        <item name="colorOutline">@color/md3_outline</item>

        <!-- Rounded corners and subtle elevation -->






    </style>

    <!-- Overlay applied automatically to BottomSheetDialogs -->
    <style name="ThemeOverlay.SmartDocAI.BottomSheet"
        parent="ThemeOverlay.Material3.DayNight.BottomSheetDialog">
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
    </style>






</resources>