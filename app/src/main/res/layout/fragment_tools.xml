<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="?android:attr/dividerHorizontal"
        android:showDividers="middle"
        android:dividerPadding="8dp"
        android:spacing="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectPdfButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select PDF" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/pdfTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:padding="12dp"
            android:background="?attr/colorSurfaceVariant"
            android:text="PDF text will appear here"
            android:scrollbars="vertical" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your question or prompt">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/promptInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/modelSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/gpt35Radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT-3.5" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/gpt4Radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT-4" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/groqRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Groq (Cloud)" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/mistralRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mistral (Local)" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask AI"
            style="?attr/materialButtonOutlinedStyle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/aiResponseDisplay"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:text="AI response will appear here"
            android:background="?attr/colorSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export and Share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export as TXT" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportPdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export as PDF" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/includeDocumentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Include Extracted Document"
            android:checked="true" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/includeAIResponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Include AI Response"
            android:checked="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick Image for OCR"
            android:layout_marginTop="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAIChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat with AI"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>