<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_background"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="88dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tools"
                android:textColor="@color/md3_onPrimaryContainer"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="Upload, OCR, Image→Excel, then ask AI."
                android:textColor="@color/md3_tertiary"
                android:textSize="13sp" />

            <!-- AI Source & Usage (also mirrored in MainActivity Tools strip) -->
            <TextView
                android:id="@+id/tvAiSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI Source: Auto-detecting..."
                android:textStyle="bold"
                android:textColor="@color/md3_tertiary"
                android:textSize="12sp"
                android:paddingBottom="2dp" />

            <LinearLayout
                android:id="@+id/usageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvUsageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usage: 0 / 300,000 tokens"
                    android:textColor="@color/md3_onPrimaryContainer"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/usageProgressBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:progress="0"
                    android:progressTint="@color/md3_primary"
                    android:indeterminate="false" />
            </LinearLayout>

            <!-- Upload / Scan jobs -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/md3_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/md3_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Get a document in"
                        android:textStyle="bold"
                        android:textColor="@color/md3_onPrimaryContainer"
                        android:textSize="16sp"
                        android:paddingBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectPdfButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Upload documents"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_uploadfile"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanDocument"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:text="Scan document"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_camera"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:strokeColor="@color/md3_outline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickImage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:text="Pick image for OCR"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_image"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:strokeColor="@color/md3_outline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImageToExcel"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:text="Image → Excel"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_excel"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:strokeColor="@color/md3_outline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCombinePdfs"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:text="Combine PDFs"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_pdf"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:strokeColor="@color/md3_outline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanId"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:text="Scan ID"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_camera"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:strokeColor="@color/md3_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>







            <!-- 🔹 Extracted Text -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/pdfTextDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:padding="12dp"
                    android:scrollbars="vertical"
                    android:text="Extracted text will appear here" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 🔹 Prompt Input (Hidden by default) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/promptContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ask something about the document"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/promptInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- 🔹 Quick AI Actions -->
            <LinearLayout
                android:id="@+id/quickAiActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiSummary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Quick summary"
                    android:textAllCaps="false"
                    app:strokeColor="@color/md3_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiActions"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:text="Action items"
                    android:textAllCaps="false"
                    app:strokeColor="@color/md3_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiKeyPoints"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:text="Key points"
                    android:textAllCaps="false"
                    app:strokeColor="@color/md3_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiAsk"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:text="Ask a question"
                    android:textAllCaps="false"
                    app:strokeColor="@color/md3_outline" />
            </LinearLayout>



            <!-- 🔹 Analyze Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/analyzeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analyze with AI"
                app:icon="@drawable/ic_robot"
                app:iconPadding="8dp"
                app:iconGravity="textStart"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_marginTop="12dp" />

            <!-- 🔹 AI Output -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/aiResponseDisplay"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:text="AI response will appear here" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp">

            </com.google.android.material.card.MaterialCardView>

            <!-- 🔹 Export Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export Options"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/includeDocumentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Include Extracted Text"
                android:checked="true" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/includeAIResponse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Include AI Response"
                android:checked="true" />

            <!-- 🔹 Export buttons grouped -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <!-- Row 1: TXT / PDF / Share -->



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:weightSum="3"
                    android:paddingHorizontal="4dp"> <!-- shrinks side padding -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportTxt"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="TXT"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAllCaps="false"
                        android:includeFontPadding="false"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_text"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp" />

                    <Space
                        android:layout_width="4dp"
                        android:layout_height="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportPdf"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="PDF"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAllCaps="false"
                        android:includeFontPadding="false"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_pdf"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp" />

                    <Space
                        android:layout_width="4dp"
                        android:layout_height="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportShare"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Share"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAllCaps="false"
                        android:includeFontPadding="false"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp" />
                </LinearLayout>
            <!-- Row 2: Word (AI Report) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportDocx"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Excel to Word (AI Report)"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAllCaps="false"
                    android:includeFontPadding="false"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_text"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:visibility="gone" />


            </LinearLayout>
   
            <!-- 🔹 AI Chat Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAIChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chat with AI"
                android:layout_marginTop="16dp"
                app:icon="@drawable/ic_chat"
                app:iconPadding="8dp"
                app:iconGravity="textStart" />



        </LinearLayout>

    </ScrollView>

    <!-- ✅ FAB: Upload/Scan only -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabUploadScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="120dp"
        android:contentDescription="Quick Upload or Scan"
        app:srcCompat="@drawable/ic_upload" />

    <!-- Dimmed overlay + centered spinner -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#66000000"
    android:clickable="true"
    android:focusable="true"
    android:layout_gravity="center">

    <ProgressBar
        android:id="@+id/loadingSpinner"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_gravity="center" />
</FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>