<?xml version="1.0" encoding="utf-8"?>


<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/selectPdfButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select PDF" />

        <TextView
            android:id="@+id/pdfTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scrollbars="vertical"
            android:text="PDF text will appear here"
            android:padding="8dp"
            android:background="#EEEEEE" />

        <EditText
            android:id="@+id/promptInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your question or prompt"
            android:minHeight="48dp" />

        <RadioGroup
            android:id="@+id/modelSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/gpt35Radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT-3.5" />

            <RadioButton
                android:id="@+id/gpt4Radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT-4" />

            <RadioButton
                android:id="@+id/groqRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Groq (Cloud)" />

            <RadioButton
                android:id="@+id/mistralRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mistral (Local)" />
        </RadioGroup>

        <Button
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask AI" />

        <TextView
            android:id="@+id/aiResponseDisplay"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scrollbars="vertical"
            android:text="AI response will appear here"
            android:padding="8dp"
            android:background="#DDFFDD" />

        <Button
            android:id="@+id/btnExportShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export and Share" />

        <Button
            android:id="@+id/btnExportTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export as TXT" />

        <Button
            android:id="@+id/btnExportPdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export as PDF" />

        <CheckBox
            android:id="@+id/includeDocumentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Include Extracted Document"
            android:checked="true" />

        <CheckBox
            android:id="@+id/includeAIResponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Include AI Response"
            android:checked="true" />

        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick Image for OCR"
            android:layout_marginTop="12dp" />


        <Button
            android:id="@+id/btnOpenAIChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat with AI"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>