<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="?android:attr/dividerHorizontal"
        android:showDividers="middle"
        android:dividerPadding="8dp"
        android:spacing="12dp">

        <!-- Section: Document Upload -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectPdfButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload PDF or Scan Image"
            app:icon="@drawable/ic_upload"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick Image for OCR"
            app:icon="@drawable/ic_image"
            app:iconPadding="8dp"
            app:iconGravity="textStart" />

        <!-- Section: Extracted Text -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/pdfTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:padding="12dp"
            android:background="?attr/colorSurfaceVariant"
            android:text="Extracted text will appear here"
            android:scrollbars="vertical" />

        <!-- Section: User Prompt -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ask something about the document"
        app:startIconTint="?attr/colorOnSurface">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/promptInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColorHint="?android:attr/textColorHint"
            android:textColor="?android:attr/textColorPrimary"
            android:background="?attr/colorSurface" />
    </com.google.android.material.textfield.TextInputLayout>
        <!-- Section: Model Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose AI Model"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"/>

        <RadioGroup
            android:id="@+id/modelSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/gpt35Radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT-3.5" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/gpt4Radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT-4" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/groqRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Groq (Cloud)" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/mistralRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mistral (Local)" />
        </RadioGroup>

        <!-- Section: Analyze -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyze with AI"
            app:icon="@drawable/ic_robot"
            style="?attr/materialButtonOutlinedStyle" />

        <!-- Section: AI Response -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/aiResponseDisplay"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:padding="12dp"
            android:text="AI response will appear here"
            android:scrollbars="vertical"
            android:background="?attr/colorSurfaceVariant" />

        <!-- Section: Export Options -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export Options"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"/>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/includeDocumentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Include Extracted Text"
            android:checked="true" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/includeAIResponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Include AI Response"
            android:checked="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportTxt"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="TXT"
                app:icon="@drawable/ic_text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportPdf"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="PDF"
                app:icon="@drawable/ic_pdf"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportShare"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Share"
                app:icon="@drawable/ic_share"/>
        </LinearLayout>

        <!-- Section: Chat -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAIChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chat with AI"
            android:layout_marginTop="16dp"
            app:icon="@drawable/ic_chat"
            app:iconPadding="8dp"
            app:iconGravity= "textStart" />
    </LinearLayout>
</ScrollView>