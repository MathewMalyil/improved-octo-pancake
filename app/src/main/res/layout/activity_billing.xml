<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Document Pro"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unlimited tools · ad-free · clean PDF export"
            android:textSize="15sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvBenefits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tvFreeNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvHowItWorks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:paddingBottom="16dp" />

        <!-- Yearly = default / recommended -->
        <Button
            android:id="@+id/btnYearly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yearly — best value"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecommended"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommended"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:textColor="?android:attr/colorPrimary" />

        <Button
            android:id="@+id/btnMonthly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monthly" />

        <Button
            android:id="@+id/btnLifetime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Lifetime — one-time" />

        <Button
            android:id="@+id/btnManagePlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage in Google Play"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnRestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restore purchases"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
