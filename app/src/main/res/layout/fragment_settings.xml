<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md3_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/md3_onPrimaryContainer"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Help, plan, and appearance."
            android:textColor="@color/md3_tertiary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Get started"
            android:textColor="@color/md3_onPrimaryContainer"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReplayOnboarding"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Replay intro walkthrough"
            android:textAllCaps="false"
            app:icon="@drawable/ic_walkthrough"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:strokeColor="@color/md3_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowGuidedWalkthrough"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Analyse guided tips"
            android:textAllCaps="false"
            app:icon="@drawable/ic_tools"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:strokeColor="@color/md3_outline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Support"
            android:textColor="@color/md3_onPrimaryContainer"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelpFaq"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Help and FAQ"
            android:textAllCaps="false"
            app:icon="@drawable/ic_help"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:strokeColor="@color/md3_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFeedback"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Send feedback"
            android:textAllCaps="false"
            app:icon="@drawable/ic_feedback"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:strokeColor="@color/md3_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrivacyPolicy"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Privacy Policy"
            android:textAllCaps="false"
            android:textColor="@color/md3_tertiary"
            app:icon="@drawable/ic_privacy"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/md3_tertiary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTerms"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Terms of Service"
            android:textAllCaps="false"
            android:textColor="@color/md3_tertiary"
            app:icon="@drawable/ic_terms"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/md3_tertiary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Plan &amp; look"
            android:textColor="@color/md3_onPrimaryContainer"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManagePlan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/md3_primary"
            android:text="Document Pro / Restore"
            android:textAllCaps="false"
            android:textColor="@color/md3_onPrimary"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Dark mode"
            android:textColor="@color/md3_onPrimaryContainer"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Version"
            android:textColor="@color/md3_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
