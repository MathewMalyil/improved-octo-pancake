<?xml version="1.0" encoding="utf-8"?>
<!--
  3.19.4: contentFrame is constrained ONLY to toolbar ↔ bottomNav.
  heroCard and adViewBanner are overlays — GONE/INVISIBLE must never
  participate in the fragment host's vertical measure (3.19.2–3.19.3 failed).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/windowBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/colorSurface"
        app:title="SmartDocAI"
        app:titleCentered="false"
        app:navigationIconTint="@android:color/black"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fragment host: full remaining height — no dependency on hero or ads -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:minHeight="240dp"
        android:background="?android:attr/windowBackground"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tools-only usage strip: OVERLAY (does not resize contentFrame) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heroCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:elevation="6dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:background="@drawable/bg_header_gradient">

            <TextView
                android:id="@+id/tvAiSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Free AI (Groq)"
                android:textColor="@color/md3_onPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 / 30000 tokens this month"
                android:textColor="@color/md3_onPrimary"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/usageProgressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:progress="0"
                android:indeterminate="false"
                android:progressTint="@color/md3_onPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickUpload"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickScan"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickOCR"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Banner sits above bottom nav; GONE must not resize contentFrame -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adViewBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        ads:adSize="BANNER"
        ads:adUnitId="@string/admob_banner_unit_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
