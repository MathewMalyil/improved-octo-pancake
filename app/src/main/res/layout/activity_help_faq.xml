<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <TextView
            android:text="Help and FAQ"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Q1 -->
        <TextView
            android:text="Q: What is SmartDocAI?"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="A: SmartDocAI is your intelligent document assistant. You can scan, upload, or pick files (PDF, XLSX, DOCX, PPTX), extract key content, and get AI-powered summaries or answers instantly."
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Q2 -->
        <TextView
            android:text="Q: How do I scan a document?"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="A: Tap the + button, choose 'Scan', and capture an image. SmartDocAI will perform OCR to extract text and analyze it with AI."
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Q3 -->
        <TextView
            android:text="Q: How does AI analysis work?"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="A: Once a document is uploaded or scanned, you can ask SmartDocAI to summarize, explain, or answer questions based on its content."
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Q4 -->
        <TextView
            android:text="Q: Is my data stored online?"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="A: No. All documents are stored locally on your device for your privacy. Only AI queries are sent securely to the selected AI model."
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Q5 -->
        <TextView
            android:text="Q: Can I export results?"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="A: Yes, you can export AI results as TXT or PDF, and share them via WhatsApp, Gmail, etc."
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- NEW Q6 -->
        <TextView
            android:text="Q: How do I enable Dark Mode?"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="A: Go to Settings and toggle 'Enable Dark Mode'. The app will instantly switch to a dark-friendly theme for comfortable reading."
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- NEW Q7 -->
        <TextView
            android:text="Q: What AI models are available?"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="A: Free users can access Groq (LLaMA) with a monthly limit, while Pro users unlock GPT-4o 🚀 for advanced analysis. GPT-3.5 is also available as a fallback within a strict limit."
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- NEW Q8 -->
        <TextView
            android:text="Q: Can I replay the guided walkthrough?"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="A: Yes. Go to Settings and tap 'Show Guided Walkthrough (Tools)'. The coach-marks will appear again to guide you through Upload → Analyze → Export."
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>