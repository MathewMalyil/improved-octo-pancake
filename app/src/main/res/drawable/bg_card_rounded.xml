<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Use the theme's surface color so it auto-switches with dark mode -->
    <solid android:color="?attr/colorSurface" />
    <corners android:radius="16dp" />
    <!-- Optional subtle outline using onSurface 12% -->
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" /> <!-- 12% white; looks fine on dark and light -->
</shape>